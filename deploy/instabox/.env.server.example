# InstaBox 部署专用示例：deploy.sh 首次执行时按此生成 .env.server（随机密码/密钥）。
# 与 deploy/.env.server.example 的唯一区别是 MUSE_DATA_DIR 指向持久盘 /data。
# Muse Register — 服务器模式配置
# 复制为 deploy/.env.server 后修改。本文件是示例，不要把填好的版本提交进仓库。
# （.dockerignore 与 .gitignore 都已排除 .env.server）

# ---- 服务器模式总开关 ----
MUSE_SERVER_MODE=1

# ---- 登录鉴权（必填，缺失或太短会拒绝启动） ----
# 账号默认 admin；密码至少 8 位；会话密钥至少 16 位、随机生成。
# 生成密钥示例：python -c "import secrets; print(secrets.token_hex(24))"
MUSE_ADMIN_USER=admin
MUSE_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
MUSE_SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# ---- 状态目录（容器内路径；对应 compose 的 ./data:/app/data 卷） ----
MUSE_DATA_DIR=/data/home/muse-register-data

# ---- 注册驱动：服务器默认 playwright（无头 Chromium），无需桌面客户端 ----
REGISTRATION_DRIVER=playwright

# ---- Playwright 无头浏览器 ----
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_USE_PROXY=true
PLAYWRIGHT_GEOIP=true
# PLAYWRIGHT_LOCALE=en-US
# PLAYWRIGHT_TIMEZONE=America/New_York
# PLAYWRIGHT_USER_DATA_DIR=/app/data/playwright-profiles/default

# ---- 其余配置与本地 .env 相同，按需填写 ----
# INVITE_CODE=
# PROXY_POOL=
# EMAIL_SOURCE=outlook
# OUTLOOK_API_BASE=
# OTP_MAX_WAIT=180
# OTP_POLL_INTERVAL=5
